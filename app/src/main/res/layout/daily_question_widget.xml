<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/daily_widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/daily_widget_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily question"
        android:textColor="#6E45D8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_widget_question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:maxLines="5"
        android:text="What do you want to talk about today?"
        android:textColor="#241B38"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to answer together"
        android:textColor="#6E647C"
        android:textSize="11sp" />
</LinearLayout>
