<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/duo_note_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/duo_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duo note"
        android:textColor="#92516A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/duo_widget_note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:maxLines="4"
        android:text="No note from your partner yet ♡"
        android:textColor="#33262C"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/duo_widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text=""
        android:textColor="#7D6B72"
        android:textSize="11sp" />
</LinearLayout>
